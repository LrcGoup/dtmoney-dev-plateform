# Recommended: same-origin proxy (refresh httpOnly cookie works without cross-site setup)
# Use /api/v3 when NEXT_PUBLIC_DT_CONNECT_V3=true
NEXT_PUBLIC_API_URL=/api/v2
API_PROXY_TARGET=http://127.0.0.1:4017

# DT Connect API v3 (dashboard JWT + docs use /api/v3/connect/* and dt-connect-key)
# NEXT_PUBLIC_DT_CONNECT_V3=true
# NEXT_PUBLIC_API_URL=/api/v3

# Optional: public API origin for Swagger links when using relative NEXT_PUBLIC_API_URL
# NEXT_PUBLIC_API_ORIGIN=https://vps101055.serveur-vps.net:4016

# Alternative: call API directly (requires backend CORS + cross-site refresh cookie)
# NEXT_PUBLIC_API_URL=https://vps101055.serveur-vps.net:4016/api/v2
